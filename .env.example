# App
NODE_ENV=production
PORT=6555
APP_TIMEZONE=America/Sao_Paulo

# Supabase — banco, autenticação e RLS.
#
# São variáveis de runtime, sem prefixo NEXT_PUBLIC_: todo acesso a dados
# acontece no servidor, então o navegador nunca recebe a chave. Mudar uma delas
# é reiniciar o container, não rebuildar a imagem.
#
# Ambas estão em Project Settings > API Keys no painel do Supabase.
SUPABASE_URL=https://seu-projeto.supabase.co
# Use a chave PUBLICÁVEL (ou "anon", nos projetos mais antigos).
# NUNCA use a service_role aqui: ela ignora o RLS e daria acesso total ao banco.
SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel-aqui

# OpenAI (transcrição e análise das reuniões)
OPENAI_API_KEY=sk-sua-chave-aqui
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# Upload de áudio das reuniões
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=200
