# Variáveis do DudaPlan.
#
# Em produção, preencha estas no painel do Coolify (Environment Variables).
# Localmente, copie para .env. Nenhum valor fica gravado no repositório.
#
# Todas são de RUNTIME — nenhuma precisa ser build arg. Não há prefixo
# NEXT_PUBLIC_ em lugar nenhum: todo acesso a dados acontece no servidor, então
# o navegador nunca recebe a chave, e trocar um valor é reiniciar o container em
# vez de rebuildar a imagem.

# --- Obrigatórias ---------------------------------------------------------

# Project Settings > Data API, no painel do Supabase.
SUPABASE_URL=

# Project Settings > API Keys. Use a chave PUBLICÁVEL (ou "anon", nos projetos
# mais antigos — o app aceita as duas, veja SUPABASE_ANON_KEY abaixo).
# NUNCA use a service_role: ela ignora o RLS e daria acesso total ao banco.
SUPABASE_PUBLISHABLE_KEY=

# --- Opcionais ------------------------------------------------------------

# Alternativa a SUPABASE_PUBLISHABLE_KEY, para projetos que ainda mostram
# "anon key" no painel. Preencha uma OU outra, não as duas.
# SUPABASE_ANON_KEY=

APP_TIMEZONE=America/Sao_Paulo

# Reuniões com IA (fatia 2). Nada usa hoje, então pode ficar vazia.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# Áudio das reuniões (fatia 2).
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=200
