# App
NODE_ENV=production
APP_TIMEZONE=America/Sao_Paulo

# Autenticação (senha única de acesso)
APP_PASSWORD=troque-esta-senha
# Gere com: openssl rand -base64 32
SESSION_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo

# Banco de dados (Postgres do docker-compose.yml)
POSTGRES_USER=dudaplan
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=dudaplan
# "db" é o nome do serviço Postgres no docker-compose.yml — não altere o host
# ao rodar via docker compose. Para desenvolvimento local sem Docker, troque
# "db" por "localhost".
DATABASE_URL=postgresql://dudaplan:troque-esta-senha@db:5432/dudaplan?schema=public

# OpenAI (transcrição e análise das reuniões)
OPENAI_API_KEY=sk-sua-chave-aqui
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# Upload de áudio das reuniões
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=200
