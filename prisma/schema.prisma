generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────── Checks Diários ───────────

model DailyCheck {
  id          String   @id @default(cuid())
  title       String
  description String?
  emoji       String?
  colorToken  String   @default("accent")
  weekdays    Int[]    @default([0, 1, 2, 3, 4, 5, 6])
  position    Int      @default(0)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  completions DailyCheckCompletion[]

  @@index([isArchived, position])
}

model DailyCheckCompletion {
  id           String     @id @default(cuid())
  dailyCheck   DailyCheck @relation(fields: [dailyCheckId], references: [id], onDelete: Cascade)
  dailyCheckId String
  date         DateTime   @db.Date
  note         String?
  completedAt  DateTime   @default(now())

  @@unique([dailyCheckId, date])
  @@index([date])
}

// ─────────── Projetos ───────────

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
  ARCHIVED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      ProjectStatus @default(ACTIVE)
  colorToken  String        @default("accent")
  startDate   DateTime?     @db.Date
  dueDate     DateTime?     @db.Date
  position    Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  notes    ProjectNote[]
  tasks    ProjectTask[]
  meetings Meeting[]

  @@index([status, position])
}

model ProjectNote {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  title     String?
  content   String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, isPinned, updatedAt])
}

enum TaskStatus {
  TODO
  DOING
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskOrigin {
  MANUAL
  MEETING_AI
}

model ProjectTask {
  id              String       @id @default(cuid())
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  title           String
  description     String?
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  dueDate         DateTime?    @db.Date
  completedAt     DateTime?
  position        Int          @default(0)
  origin          TaskOrigin   @default(MANUAL)
  sourceMeeting   Meeting?     @relation(fields: [sourceMeetingId], references: [id], onDelete: SetNull)
  sourceMeetingId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([projectId, status, position])
}

// ─────────── Reuniões + IA ───────────

enum MeetingStatus {
  DRAFT
  UPLOADED
  TRANSCRIBING
  ANALYZING
  COMPLETED
  FAILED
}

model Meeting {
  id           String        @id @default(cuid())
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  title        String
  meetingDate  DateTime      @default(now())
  participants String[]      @default([])
  contextNotes String?
  status       MeetingStatus @default(DRAFT)

  audioPath       String?
  audioMimeType   String?
  audioSizeBytes  Int?
  durationSeconds Int?

  transcript         String?
  transcriptLanguage String?
  summaryMarkdown    String?
  problems           Json?
  decisions          Json?
  actionPlan         Json?
  risks              Json?
  flowchartMermaid   String?
  flowchartTitle     String?

  transcribeModel     String?
  analysisModel       String?
  promptTokens        Int?
  completionTokens    Int?
  errorMessage        String?
  attempts            Int       @default(0)
  processingStartedAt DateTime?
  processedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedTasks ProjectTask[]

  @@index([projectId, meetingDate])
  @@index([status])
}

// ─────────── Configuração ───────────

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
